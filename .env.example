# Copie para .env.local (dev) e cadastre as mesmas na Vercel → Settings → Environment Variables.

# String de conexão do PostgreSQL (Neon, Vercel Postgres, RDS, servidor próprio…).
# Em provedor gerenciado, inclua ?sslmode=require.
DATABASE_URL=postgres://usuario:senha@host:5432/banco

# Segredo que assina o cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
